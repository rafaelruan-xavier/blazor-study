<div class="card-artista">
    <img src="@ArtistaResponse?.FotoPerfil" class="card-img" />
    <div class="card-body">
        <h4>@ArtistaResponse.Nome</h4>
        <p class="bio">@ArtistaResponse.Bio</p>
        <a class="btn" href="/artist/@ArtistaResponse.Nome">Detalhes</a>        
    </div>
</div>


@code {
    [Parameter]
    public ArtistaResponse ArtistaResponse { get; set; }   

}
